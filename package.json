{
  "name": "agent-commons",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "mcp": "node --import tsx src/mcp/stdio.ts",
    "mcp:local:migrate": "wrangler d1 migrations apply DB --local --config wrangler.registry-local.jsonc --persist-to .wrangler/mcp-local",
    "mcp:local:bootstrap": "node --import tsx scripts/bootstrap-mcp-local.ts",
    "needs:review:local": "node --import tsx scripts/review-needs-local.ts",
    "versions:review:local": "node --import tsx scripts/review-versions-local.ts",
    "review:remote": "node --import tsx scripts/review-remote.ts",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.ts\" \"*.{json,jsonc,mjs}\" \".github/workflows/*.yml\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.ts\" \"*.{json,jsonc,mjs}\" \".github/workflows/*.yml\"",
    "lint": "eslint src test --max-warnings=0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json && tsc --noEmit -p tsconfig.d1-test.json && tsc --noEmit -p tsconfig.r2-test.json && tsc --noEmit -p tsconfig.identity-test.json && tsc --noEmit -p tsconfig.registry-test.json",
    "verify": "npm run typecheck && npm run format:check && npm run lint && npm test && npx wrangler deploy --dry-run",
    "test": "vitest run",
    "r2:verify:local": "vitest run test/storage",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.d1-local.jsonc --persist-to .wrangler/d1-verify",
    "seed:verify:httpbin": "node scripts/verify-httpbin-seed.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.159.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    }
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.6",
    "@modelcontextprotocol/server": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "zod": "^4.6.7"
  }
}
