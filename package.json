{
  "name": "agent-commons",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.{json,jsonc,mjs}\" \".github/workflows/*.yml\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.{json,jsonc,mjs}\" \".github/workflows/*.yml\"",
    "lint": "eslint src test --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.2",
    "vitest": "^2.1.0",
    "wrangler": "^4.159.0"
  }
}
