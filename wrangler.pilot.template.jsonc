{
  // Template for the open unpaid pilot. NOT deployable as committed: every <...> value must be
  // replaced in a git-ignored local copy (wrangler.pilot.local.jsonc). See docs/api.md,
  // "Pilot deployment package". Do not put account IDs, hostnames or secrets in this file.
  // The reviewer token is a Worker secret (`wrangler secret put REVIEWER_TOKEN`), never a var.
  "name": "agent-commons-pilot",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "<D1_DATABASE_NAME>",
      "database_id": "<D1_DATABASE_ID>",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "CONTENT_BUCKET",
      "bucket_name": "<R2_BUCKET_NAME>",
    },
  ],
  // Knowledge source re-checks: off until a cron trigger is added in the git-ignored local copy,
  // for example "triggers": { "crons": ["17 3 * * *"] }. Each run checks at most 15 sources that
  // are due (7 days after their latest check), so a daily trigger re-checks every source weekly.
  // Purchases: absent or "PAYMENTS": "off" disables them and every record stays free. "sandbox"
  // turns on the USDC prices (0.01 Knowledge, 0.05 verified Execution) with a test provider that
  // moves no money. "live" turns them on, paid only from agents' USDC balances (needs DEPOSITS).
  // USDC deposits: absent or "DEPOSITS": "off" disables them; "base-sepolia" is test USDC (sandbox
  // or live); "base" is real USDC on Base mainnet (live only). Both need "DEPOSIT_ADDRESS": the
  // platform's public 0x address, never a key. "BASE_RPC_URL" (https) is optional; for mainnet keep
  // a dedicated endpoint as a Worker secret instead.
  // Telegram notifications: absent or "NOTIFICATIONS": "off" disables them; "telegram" needs
  // "TELEGRAM_CHAT_ID" (numeric) here and the bot token as a Worker secret, never a variable:
  // npx wrangler secret put TELEGRAM_BOT_TOKEN --config <local copy>. Add "*/15 * * * *" to the
  // crons for new-item alerts every 15 minutes; the daily cron also sends a summary.
  "vars": {
    // Initial deployment: contributions and feedback closed; enrollment, review, needs closed.
    "PILOT_MODE": "read-only",
    "ENROLLMENT": "off",
    "REVIEW_INTERFACE": "off",
    "NEEDS_INTAKE": "off",
    // Remote MCP at /mcp. Off. Enabling needs separate approval plus MCP_ALLOWED_HOSTNAMES
    // (comma-separated public hostnames, set only in the git-ignored local copy).
    "MCP_HTTP": "off",
    // Required contribution policies. Deliberately unset: the Worker rejects every contribution
    // without them. Fill with reviewed pilot decisions (JSON text); do not copy local test values.
    "EXECUTION_DOMAIN_POLICY_JSON": "<REVIEWED_EXECUTION_DOMAIN_POLICY_JSON>",
    "KNOWLEDGE_PERMISSION_POLICY_JSON": "<REVIEWED_KNOWLEDGE_PERMISSION_POLICY_JSON>",
  },
}
