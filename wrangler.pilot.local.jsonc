{
  "name": "agent-commons-pilot",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-commons-pilot",
      "database_id": "67b85e67-91cc-4b6a-bbed-3db4d76cc972",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CONTENT_BUCKET",
      "bucket_name": "agent-commons-content-pilot"
    }
  ],
  "workers_dev": true,
  "routes": [{ "pattern": "agent-commons.dev", "custom_domain": true }],
  "vars": {
    "PILOT_MODE": "off",
    "ENROLLMENT": "on",
    "ENROLLMENT_DOMAIN": "agent-commons.dev",
    "ENROLLMENT_URI": "https://agent-commons.dev/",
    "ENROLLMENT_CHAIN_ID": "1",
    "REVIEW_INTERFACE": "on",
    "REVIEWER_ID": "lankylo",
    "NEEDS_INTAKE": "on",
    "MCP_HTTP": "on",
    "MCP_ALLOWED_HOSTNAMES": "agent-commons.dev,agent-commons-pilot.lorenzo-leray.workers.dev",
    "EXECUTION_DOMAIN_POLICY_JSON": "{\"allowed\":[{\"domain\":\"httpbin.org\",\"includeSubdomains\":false},{\"domain\":\"api.github.com\",\"includeSubdomains\":false},{\"domain\":\"pypi.org\",\"includeSubdomains\":false},{\"domain\":\"api.frankfurter.dev\",\"includeSubdomains\":false}],\"denied\":[]}",
    "KNOWLEDGE_PERMISSION_POLICY_JSON": "{\"permittedCombinations\":[{\"sourceLicense\":\"ISC\",\"permittedUse\":\"redistribute\",\"dataPermission\":\"redistribution-allowed\"},{\"sourceLicense\":\"CC-BY-4.0\",\"permittedUse\":\"redistribute\",\"dataPermission\":\"redistribution-allowed\"},{\"sourceLicense\":\"Apache-2.0\",\"permittedUse\":\"redistribute\",\"dataPermission\":\"redistribution-allowed\"},{\"sourceLicense\":\"MIT\",\"permittedUse\":\"redistribute\",\"dataPermission\":\"redistribution-allowed\"}]}",
    "NOTIFICATIONS": "telegram",
    "TELEGRAM_CHAT_ID": "7747064211",
    "PAYMENTS": "live",
    "DEPOSITS": "base",
    "DEPOSIT_ADDRESS": "0x080f5bA23C6b0f94981AbACee1a4b705edD1909f",
  },
    "triggers": { "crons": ["17 3 * * *", "*/15 * * * *"] },
}
